#!name=Currency
#!desc=Quantumult X -> Surge module syntax study
#!system=ios

[Script]
Currency Request = type=http-request,pattern=^https?:\/\/api\.revenuecat\.com\/v1\/(subscribers\/[^\/]+$|receipts$),script-path=https://raw.githubusercontent.com/Acacia415/surge/refs/heads/main/Currency.js,requires-body=true

Currency Response = type=http-response,pattern=^https?:\/\/api\.revenuecat\.com\/v1\/(subscribers\/[^\/]+$|receipts$),script-path=https://raw.githubusercontent.com/Acacia415/surge/refs/heads/main/Currency.js,requires-body=true

[MITM]
hostname = %APPEND% api.revenuecat.com
